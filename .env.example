# ──────────────────────────────────────────────
# Dhaka Tesla Pool – Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────
POSTGRES_USER=teslapool
POSTGRES_PASSWORD=teslapool_secret
POSTGRES_DB=teslapool_db
POSTGRES_PORT=5432

# ── Backend ────────────────────────────────────
DATABASE_URL=postgresql://teslapool:teslapool_secret@localhost:5432/teslapool_db
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api
